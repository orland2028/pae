# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
SUPABASE_SECRET_KEY=your-secret-key-here

# Database Configuration (PostgreSQL via Supabase)
POSTGRES_URL=your-postgres-url-here
POSTGRES_URL_NON_POOLING=your-postgres-url-non-pooling-here
POSTGRES_PRISMA_URL=your-postgres-prisma-url-here
POSTGRES_HOST=your-postgres-host
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=postgres

# API Keys
AI_GATEWAY_API_KEY=your-ai-gateway-key-here

# Vercel Configuration (for deployments)
VERCEL_WEB_ANALYTICS_ID=your-analytics-id-here
VERCEL_OIDC_TOKEN=your-oidc-token-here

# Development URLs
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
V0_RUNTIME_URL=http://localhost:3000
V0_CALLBACK_URL=http://localhost:3000/callback
